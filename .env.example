# Backend (api service). docker-compose.yml sets these for local development.
DATABASE_URL=postgresql://readiness:readiness@localhost:5433/readiness
# Fixed demo clock so seeded due/overdue/late states never drift. Blank = real date.
DEMO_TODAY=2026-11-24
# Allow POST /api/demo/reset (disposable demo database only).
DEMO_RESET_ENABLED=true
# Optional: require X-Demo-Reset-Token on reset in shared deployments.
DEMO_RESET_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Frontend (web service): where nginx proxies /api.
API_UPSTREAM=http://api:8000
